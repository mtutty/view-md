<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ViewMd.PreferencesWindow"
        Title="Preferences"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Theme" Width="130" VerticalAlignment="Center" />
            <ComboBox Name="ThemeCombo" Width="200">
                <ComboBoxItem>System</ComboBoxItem>
                <ComboBoxItem>Light</ComboBoxItem>
                <ComboBoxItem>Dark</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Font family" Width="130" VerticalAlignment="Center" />
            <ComboBox Name="FontFamilyCombo" Width="200" IsEditable="True">
                <ComboBoxItem>Default</ComboBoxItem>
                <ComboBoxItem>Sans Serif</ComboBoxItem>
                <ComboBoxItem>Serif</ComboBoxItem>
                <ComboBoxItem>Monospace</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Font size" Width="130" VerticalAlignment="Center" />
            <NumericUpDown Name="FontSizeUpDown" Width="200" Minimum="8" Maximum="32" Increment="1" FormatString="0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Line spacing" Width="130" VerticalAlignment="Center" />
            <NumericUpDown Name="LineHeightUpDown" Width="200" Minimum="1.0" Maximum="2.0" Increment="0.05" FormatString="0.00" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Document margin" Width="130" VerticalAlignment="Center" />
            <NumericUpDown Name="MarginUpDown" Width="200" Minimum="0" Maximum="80" Increment="4" FormatString="0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancelClick" Width="80" />
            <Button Content="OK" Click="OnOkClick" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
