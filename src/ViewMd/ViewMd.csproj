<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>view-md</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- SelfContained and the RID are deliberately NOT set unconditionally
         here: setting SelfContained true project-wide breaks a plain build
         or run for any project that references this one non-self-contained
         (e.g. tools/SmokeTest). Pass the RID and self-contained flag on the
         publish command line instead (see packaging/build-*.sh). -->
  </PropertyGroup>

  <!-- NativeAOT only for linux-x64, see .charter/decisions.md: Native AOT
       cannot cross-compile between operating systems (Microsoft Learn,
       "Cross-compilation - .NET"), so win-x64/osx-arm64 builds produced from
       this Linux build host are self-contained JIT publishes instead — see
       packaging/build-windows.sh and packaging/build-macos.sh. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Versioning: base version comes from /version.txt (source of truth, see
       .charter/decisions.md), git short hash is appended so a build can be
       traced back to the exact commit. CI passes -p:GitHashOverride=... (from
       Jenkins' own GIT_COMMIT) to avoid needing git inside the build
       container; local/dev builds fall back to invoking git directly. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
  </PropertyGroup>

  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile;GetAssemblyVersion">
    <ReadLinesFromFile File="$(RepoRoot)version.txt">
      <Output TaskParameter="Lines" ItemName="_VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_BaseVersion>@(_VersionLines)</_BaseVersion>
      <_GitHash Condition="'$(GitHashOverride)' != ''">$(GitHashOverride)</_GitHash>
    </PropertyGroup>

    <Exec Condition="'$(_GitHash)' == '' and Exists('$(RepoRoot).git')"
          Command="git -C &quot;$(RepoRoot)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHashRaw" />
    </Exec>
    <Exec Condition="'$(_GitHash)' == '' and Exists('$(RepoRoot).git')"
          Command="git -C &quot;$(RepoRoot)&quot; status --porcelain"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirtyRaw" />
    </Exec>

    <PropertyGroup>
      <_GitHash Condition="'$(_GitHash)' == '' and '$(_GitHashRaw)' != ''">$(_GitHashRaw)</_GitHash>
      <_GitHash Condition="'$(_GitHash)' == ''">unknown</_GitHash>
      <_GitHash Condition="'$(_GitHash)' != 'unknown' and '$(_GitDirtyRaw)' != ''">$(_GitHash)-dirty</_GitHash>
      <Version>$(_BaseVersion)</Version>
      <InformationalVersion>$(_BaseVersion)+$(_GitHash)</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
      <_VersionInfoLines Include="// Auto-generated at build time from version.txt + git hash. Do not edit." />
      <_VersionInfoLines Include="namespace ViewMd%3B" />
      <_VersionInfoLines Include="internal static class VersionInfo" />
      <_VersionInfoLines Include="{" />
      <_VersionInfoLines Include="    public const string BaseVersion = &quot;$(_BaseVersion)&quot;%3B" />
      <_VersionInfoLines Include="    public const string GitHash = &quot;$(_GitHash)&quot;%3B" />
      <_VersionInfoLines Include="    public const string InformationalVersion = &quot;$(_BaseVersion)+$(_GitHash)&quot;%3B" />
      <_VersionInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)VersionInfo.g.cs" Lines="@(_VersionInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- Pinned to exactly match Avalonia.Skia's own SkiaSharp dependency (see
         .charter/decisions.md) — letting this float independently causes a managed/
         native version mismatch at runtime (TypeInitializationException). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
</Project>
